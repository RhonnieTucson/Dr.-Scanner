<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- ── Barra superior personalizada ───────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnVolver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="@color/cyan"
            android:textSize="20sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvCodigoTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/cyan"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.2" />

        <TextView
            android:id="@+id/btnCompartir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⤴"
            android:textColor="@color/cyan"
            android:textSize="18sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollResultado"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Código + urgencia ──────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvSistema"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:letterSpacing="0.15" />

            <TextView
                android:id="@+id/tvUrgencia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="URGENTE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:background="@drawable/bg_badge_off" />
        </LinearLayout>

        <!-- Fuente -->
        <TextView
            android:id="@+id/tvFuente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● BASE LOCAL · OFFLINE"
            android:textColor="@color/urgencia_bajo"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="20dp" />

        <!-- ¿Qué significa? -->
        <TextView
            style="@style/TextLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿QUÉ SIGNIFICA?"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvSimple"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/silver"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginBottom="20dp" />

        <!-- Explicación -->
        <TextView
            style="@style/TextLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EXPLICACIÓN SENCILLA"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvExplicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.75"
            android:layout_marginBottom="20dp" />

        <!-- Info boxes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginEnd="8dp">

                <TextView
                    style="@style/TextLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿PUEDES MANEJAR?"
                    android:layout_marginBottom="5dp" />

                <TextView
                    android:id="@+id/tvPuedeManejar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/silver"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp">

                <TextView
                    style="@style/TextLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SISTEMA AFECTADO"
                    android:layout_marginBottom="5dp" />

                <TextView
                    android:id="@+id/tvSistemaBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/silver"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Pasos -->
        <TextView
            style="@style/TextLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿QUÉ HACER?"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/containerPasos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp" />

        <!-- Nota -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:layout_marginBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ℹ"
                android:textColor="@color/cyan"
                android:textSize="16sp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Este diagnóstico está en lenguaje simple. Para una reparación precisa, consulta a un mecánico profesional."
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.6" />
        </LinearLayout>

    </LinearLayout>
    </ScrollView>
</LinearLayout>
