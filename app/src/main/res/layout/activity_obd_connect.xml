<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← "
            android:textColor="@color/cyan"
            android:textSize="18sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CONECTAR OBD2"
            android:textColor="@color/silver"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/btnRefrescar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↻ Buscar"
            android:textColor="@color/cyan"
            android:textSize="13sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Instrucciones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ℹ INSTRUCCIONES"
                    android:textColor="@color/cyan"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Conecta el adaptador OBD2 al puerto del carro (debajo del tablero)
2. Enciende el carro (llave en ACC o motor encendido)
3. Ve a Ajustes > Bluetooth en tu celular y vincula el OBD2
4. Regresa aquí y selecciona el dispositivo"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.6" />
            </LinearLayout>

            <!-- Estado conectado (oculto por defecto) -->
            <LinearLayout
                android:id="@+id/layoutConectado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_badge_on"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvConectadoNombre"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/urgencia_bajo"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnDesconectar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Desconectar"
                    android:textColor="@color/urgencia_alto"
                    android:textSize="12sp"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                style="@style/TextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISPOSITIVOS BLUETOOTH VINCULADOS"
                android:layout_marginBottom="12dp" />

            <!-- Progreso -->
            <ProgressBar
                android:id="@+id/progressObd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:visibility="gone" />

            <!-- Lista de dispositivos -->
            <LinearLayout
                android:id="@+id/containerDispositivos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Sin dispositivos -->
            <LinearLayout
                android:id="@+id/layoutSinDispositivos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sin dispositivos Bluetooth vinculados.
Ve a Ajustes > Bluetooth y vincula el adaptador OBD2 primero."
                    android:textColor="@color/muted"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.5" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
