<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.DrScanner" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/cyan</item>
        <item name="colorPrimaryVariant">@color/cyan2</item>
        <item name="colorOnPrimary">@color/bg</item>

        <item name="colorSecondary">@color/cyan2</item>
        <item name="colorOnSecondary">@color/bg</item>

        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_main</item>
        <item name="colorOnBackground">@color/text_main</item>

        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg2</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>

        <item name="bottomNavigationStyle">@style/Widget.DrScanner.BottomNav</item>
    </style>

    <style name="Widget.DrScanner.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/bg2</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
    </style>

    <style name="TextLabel">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextValue">
        <item name="android:textColor">@color/silver</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
